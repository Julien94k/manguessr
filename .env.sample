# ---- Ports exposes sur l'hote -------------------------------------------------
HOST_FRONTEND_PORT=8091
# 5432 est souvent deja pris par un autre projet : on decale cote hote.
HOST_DB_PORT=5434

# ---- Base de donnees ----------------------------------------------------------
DB_NAME=manguessr
DB_USER=manguessr
# Fixe a la creation du volume Postgres : le changer ensuite n'a plus d'effet sur la base.
DB_PASSWORD=change_me

# ---- Securite -----------------------------------------------------------------
# Doit faire au moins 256 bits (32 caracteres) pour HS256. A generer, jamais la valeur d'exemple :
# quiconque la connait peut forger un jeton admin.   openssl rand -base64 48
JWT_SECRET=change_me_this_secret_must_be_at_least_256_bits_long_for_hs256
JWT_EXPIRATION=2592000000
# Origines autorisees, separees par des virgules. Derriere un tunnel Cloudflare, lister le domaine
# public (le navigateur l'envoie en https alors que nginx recoit du http) plus les acces locaux :
# CORS_ALLOWED_ORIGINS=https://manguessr.example.com,http://localhost:3000,http://localhost:8091
CORS_ALLOWED_ORIGINS=*

# ---- Catalogue ----------------------------------------------------------------
CATALOG_PROVIDER=anilist

# Volumes d'ingestion. 20 pages x 50 = 1000 oeuvres par univers.
CATALOG_MAX_PAGES=20
CATALOG_PAGE_SIZE=50

# AniList exige un Referer : sans lui, il repond 403 avec un message evoquant a tort
# une panne globale. Ne pas vider cette variable.
ANILIST_REFERER=https://anilist.co/
ANILIST_USER_AGENT=manguessr/1.0
ANILIST_RPM=30

# MangaDex : couvertures de volumes et pages de chapitres (mode Images cote manga).
MANGADEX_USER_AGENT=manguessr/1.0
MANGADEX_RPS=4
MANGADEX_MAPPING_SIZE=2000
MANGADEX_MAX_COVERS=400
# 4 requetes par manga, dont 3 plafonnees a 40/min cote MangaDex : ~7 s par manga.
MANGADEX_MAX_PAGES=400

# AnimeThemes : generiques. Etape la plus lente, ~1,7 s par anime.
ANIMETHEMES_USER_AGENT=manguessr/1.0
ANIMETHEMES_RPS=4
ANIMETHEMES_MAX_WORKS=400

# ---- Backend ------------------------------------------------------------------
# Ces deux valeurs ne servent qu'au dev hors conteneur : docker-compose les impose en production.
SERVER_PORT=8080
MEDIA_CACHE_PATH=./media-cache

# Genere les puzzles du jour a 00:05 UTC et au demarrage.
DAILY_SCHEDULER_ENABLED=true

# Emails promus ROLE_ADMIN a l'inscription (peuvent declencher l'ingestion).
ADMIN_EMAILS=
